# Compiler files
cache/
out/
__pycache__/

# Ignores development broadcast logs
/broadcast

# Dotenv file
.env

# Local agent config, and .claude/docs/ — the private home for every internal
# document (specs, plans, audit workpapers, incident runbooks, ops templates).
# This repo is PUBLIC. Published docs go in docs/, which is deliberately NOT
# ignored: ignoring it is what left an agent with nowhere to put a document
# except the repo root, and four internal audit specs shipped with v0.8.0 as a
# result. See deploy-testnet docs/documentation-standard.md.
.claude/

# Backstop for the same class at the repo root: internal docs have historically
# been written here by name shape (…_SPEC.md, …_RUNBOOK.md, …_AUDIT_*.md).
/*_SPEC.md
/*_SPECIFICATION.md
/*_RUNBOOK.md
/*_PLAN.md
/*_NOTES.md
/*_AUDIT*.md
/*AUDIT_*.md
/*_INCIDENT*.md
/*_REMEDIATION*.md
/*_CLOSEOUT*.md
/*_POSTMORTEM.md
/*_POST_MORTEM.md
/*_HANDOFF.md
/*_WIP.md
/INTERNAL*.md
/TODO.md
/SCRATCH.md
/SCRATCHPAD.md

# Local helper scripts (created on the fly to work around WSL bash -c quoting)
.run-*.sh
.balance-check.sh
