# Install as /etc/daski/external-identity-monitor.env with mode 0600.
# MONITOR_RPC_URL and signer credentials belong in the service secret store.
MONITOR_MANIFEST_PATH=/etc/daski/release-manifest.json
MONITOR_RELEASE_SUMMARY_PATH=/etc/daski/release-summary.json
MONITOR_RPC_URL=
MONITOR_EVIDENCE_DIR=/var/lib/daski-release-evidence
MONITOR_INTERVAL_SECONDS=30
MONITOR_GUARDIAN_COMMAND=/opt/daski-release-ops/bin/pause-guardian
MONITOR_ALERT_COMMAND=/opt/daski-release-ops/bin/security-alert
