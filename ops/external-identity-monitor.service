[Unit]
Description=Daski external identity release monitor
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=daski-release-monitor
Group=daski-release-monitor
EnvironmentFile=/etc/daski/external-identity-monitor.env
WorkingDirectory=/opt/daski
ExecStartPre=/usr/bin/python3 /opt/daski/script/monitor_external_identity.py --manifest ${MONITOR_MANIFEST_PATH} --release-summary ${MONITOR_RELEASE_SUMMARY_PATH} --rpc-url ${MONITOR_RPC_URL} --evidence-dir ${MONITOR_EVIDENCE_DIR} --interval-seconds ${MONITOR_INTERVAL_SECONDS} --once --check-only
ExecStart=/usr/bin/python3 /opt/daski/script/monitor_external_identity.py --manifest ${MONITOR_MANIFEST_PATH} --release-summary ${MONITOR_RELEASE_SUMMARY_PATH} --rpc-url ${MONITOR_RPC_URL} --evidence-dir ${MONITOR_EVIDENCE_DIR} --interval-seconds ${MONITOR_INTERVAL_SECONDS} --guardian-command ${MONITOR_GUARDIAN_COMMAND} --alert-command ${MONITOR_ALERT_COMMAND}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/daski-release-evidence

[Install]
WantedBy=multi-user.target
